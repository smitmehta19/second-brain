# === Mind Palace Configuration ===

# Telegram Bot (required)
# Create bot: message @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram user ID (find via @userinfobot). Empty = allow everyone.
TELEGRAM_ALLOWED_USERS=

# ============================================================
# AI PROVIDER (pick at least ONE — all have free tiers)
# ============================================================
# Set AI_PROVIDER to: auto, gemini, groq, ollama, openai, or claude
# "auto" tries them in order until one works
AI_PROVIDER=auto

# Option 1: GEMINI (recommended — FREE: 15 req/min, 1M tokens/day)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Option 2: GROQ (FREE: 30 req/min, 14,400 req/day)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: OLLAMA (FREE: runs locally, no key needed)
# Install: https://ollama.com → ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option 4: OPENAI (paid — ~$0.15/1M tokens with gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option 5: CLAUDE (paid — ~$3/1M tokens, highest quality)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ============================================================
# NOTION (optional — disable with ENABLE_NOTION_SYNC=false)
# ============================================================
# Create integration: https://www.notion.so/my-integrations
NOTION_API_KEY=
NOTION_INBOX_DATABASE_ID=
NOTION_RESOURCES_DATABASE_ID=

# ============================================================
# OTHER SETTINGS
# ============================================================
OBSIDIAN_VAULT_PATH=./vault
MAX_CONCURRENT_JOBS=5
EXTRACTION_TIMEOUT=30
AUTO_CATEGORIZE=true
DB_PATH=./data/secondbrain.db

# Feature toggles
ENABLE_NOTION_SYNC=true
ENABLE_OBSIDIAN_SYNC=false
# ^ Set to true ONLY if you want local Obsidian vault + pay for Obsidian Sync ($4/mo)
# Notion alone is enough — it's free and has mobile/web/desktop apps
ENABLE_VOICE_TRANSCRIPTION=true
ENABLE_IMAGE_OCR=true
