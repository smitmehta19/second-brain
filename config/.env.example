# === Second Brain Configuration ===

# Telegram Bot (required)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Restrict bot to your Telegram user ID only (comma-separated, empty = allow all)
# Find your ID: message @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=

# Claude API (required for AI categorization)
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# Notion (optional — set enable_notion_sync=false to skip)
NOTION_API_KEY=your_notion_integration_token
NOTION_INBOX_DATABASE_ID=your_inbox_db_id
NOTION_RESOURCES_DATABASE_ID=your_resources_db_id

# Obsidian vault path (required)
OBSIDIAN_VAULT_PATH=./vault

# Pipeline settings
MAX_CONCURRENT_JOBS=5
EXTRACTION_TIMEOUT=30
AUTO_CATEGORIZE=true

# Database
DB_PATH=./data/secondbrain.db

# Feature toggles
ENABLE_NOTION_SYNC=true
ENABLE_OBSIDIAN_SYNC=true
ENABLE_VOICE_TRANSCRIPTION=true
ENABLE_IMAGE_OCR=true
